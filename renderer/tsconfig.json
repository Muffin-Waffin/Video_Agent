{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@engine/*": ["engine/*"],
      "@assets/*": ["assets/*"],
      "@stories/*": ["stories/*"]
    }
  },
  "include": ["src/**/*", "engine/**/*", "stories/**/*"],
  "exclude": ["node_modules", "dist"]
}
